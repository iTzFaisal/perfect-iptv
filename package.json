{
  "name": "perfect-iptv",
  "version": "0.1.5",
  "private": true,
  "description": "A native Samsung Tizen TV IPTV player for Xtream Codes providers.",
  "scripts": {
    "serve": "node mock/server.js",
    "check": "bash scripts/check.sh",
    "test": "node scripts/test-ui.js",
    "test:unit": "node --test test/unit",
    "test:smoke": "SMOKE=1 node scripts/test-ui.js",
    "test:native": "node scripts/test-native.js",
    "test:real": "node scripts/test-real.js",
    "verify": "npm run check && npm run test:unit && npm test && npm run test:native",
    "package": "bash scripts/package.sh"
  },
  "keywords": [
    "tizen",
    "samsung",
    "iptv",
    "xtream"
  ],
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
